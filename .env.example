# Copy to .dev.vars. Never commit your filled-in .dev.vars.
# Use a random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLAID_CONNECTOR_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox = simulated test institutions; production = approved real-bank access.
PLAID_ENV=sandbox
# Exact browser origin. Use 127.0.0.1 consistently, not alternating with localhost.
PLAID_APP_ORIGIN=http://127.0.0.1:3000
# Optional. Register this exact redirect in the Plaid Dashboard first.
# PLAID_REDIRECT_URI=http://127.0.0.1:3000/
